# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
node_modules
.pnp
.pnp.js

# testing
coverage

# kizlo working dir, at any depth — everything in it is disposable
.kizlo/

# local WordPress dev install (kizlo dev — dev.path)
/web/wordpress/

# next.js
.next/
out/
next-env.d.ts

# nitro
.nitro/
.output/

# expo
.expo/
expo-env.d.ts
apps/expo/.gitignore
apps/expo/ios
apps/expo/android

# production
build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# local env files
.env
.env*.local

# vercel
.vercel

# typescript
dist/
.cache
*.tsbuildinfo

# composer (plugin deps stay out of git; composer.lock stays in)
plugins/*/vendor/

# turbo
.turbo

.wrangler
.dev.vars

.source

debug.txt

.fallow

.temp
# agent worktrees (one isolated checkout per session)
# .worktrees/ is where the workflow skill puts them; harnesses that pick their
# own location keep using theirs, so all of them are ignored. .agents/worktrees/
# is the skill's old location, kept here so a session still running the old
# instructions cannot commit a checkout.
.worktrees/
.agents/worktrees/
.claude/worktrees/
