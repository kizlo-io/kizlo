{
	"name": "@templates/nextjs",
	"version": "0.0.0",
	"private": true,
	"type": "module",
	"scripts": {
		"dev:template": "dotenv -e ../../.env -- next dev --webpack",
		"build": "dotenv -e ../../.env -- next build",
		"start": "dotenv -e ../../.env -- next start",
		"typecheck": "tsc --noEmit",
		"clean": "git clean -xdf .cache .turbo .kizlo .next .source dist node_modules"
