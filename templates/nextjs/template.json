{
	"id": "nextjs",
	"name": "Next.js",
	"minCli": "0.14.0",
	"config": {
		"alias": "@",
		"apiPath": "/api/kizlo",
		"kizloPath": "src/lib/kizlo"
	},
	"init": {
		"requires": [
			{
				"kind": "dep",
				"values": ["next"]
			},
			{
				"kind": "dir",
				"values": ["app", "src/app"],
				"message": "Kizlo needs the Next.js App Router — no `app` or `src/app` directory found. The Pages Router isn't supported."
			}
		]
	},
	"create": {
		"command": "{{pm}} create next-app@latest {{name}} --ts --app --src-dir --import-alias @/* {{linter}} {{tailwind}} {{reactCompiler}} --skip-install --disable-git --use-{{pm}} --yes",
		"prompts": [
			{
				"kind": "select",
				"token": "linter",
				"message": "Which linter would you like to use?",
				"default": "none",
				"options": [
					{
						"label": "ESLint",
						"value": "eslint",
						"arg": "--eslint"
					},
					{
						"label": "Biome",
						"value": "biome",
						"arg": "--biome"
					},
					{
						"label": "None",
						"value": "none",
						"arg": "--no-eslint"
					}
				]
			},
			{
				"kind": "confirm",
				"token": "tailwind",
				"message": "Add Tailwind CSS?",
				"default": false,
				"arg": "--tailwind",
				"argFalse": "--no-tailwind"
			},
			{
				"kind": "confirm",
				"token": "reactCompiler",
				"message": "Enable the React Compiler?",
				"default": false,
				"arg": "--react-compiler",
				"argFalse": ""
			}
		]
	},
	"changes": {
		"base": [
			{
				"kind": "file",
				"role": "server-entry",
				"path": "src/lib/kizlo/server/index.ts"
			},
			{
				"kind": "file",
				"role": "client",
				"path": "src/lib/kizlo/client.ts"
			},
			{
				"kind": "file",
				"role": "api-route",
				"path": "src/app/api/kizlo/[[...rest]]/route.ts"
			},
			{
				"kind": "file",
				"role": "robots",
				"path": "src/app/robots.txt/route.ts"
			},
			{
				"kind": "file",
				"role": "sitemap",
				"path": "src/app/sitemaps/[sitemap]/route.ts"
			},
			{
				"kind": "file",
				"role": "sitemap-redirect",
				"path": "src/app/sitemap.xml/route.ts"
			},
			{
				"kind": "file",
				"role": "manifest",
				"path": "src/app/site.webmanifest/route.ts"
			},
			{
				"kind": "file",
				"role": "blog-post",
				"path": "src/app/blog/[slug]/page.tsx",
				"example": true
			}
		],
		"create": [
			{
				"kind": "file",
				"role": "root-layout",
				"path": "src/app/layout.tsx"
			},
			{
				"kind": "file",
				"role": "home-page",
				"path": "src/app/page.tsx",
				"example": true
			}
		],
		"init": [
			{
				"kind": "patch",
				"role": "root-layout",
				"label": "root layout",
				"path": "src/app/layout.tsx",
				"imports": [
					{
						"module": "kizlo/nextjs/server",
						"names": ["createRootMetadata", "createRootViewport"]
					},
					{
						"module": "{{serverImport}}",
						"names": ["client"]
					}
				],
				"exports": [
					{
						"name": "generateMetadata",
						"value": "createRootMetadata(client)"
					},
					{
						"name": "generateViewport",
						"value": "createRootViewport(client)"
					}
				]
			},
			{
				"kind": "patch",
				"role": "home-page",
				"label": "home page",
				"path": "src/app/page.tsx",
				"imports": [
					{
						"module": "kizlo/nextjs/server",
						"names": ["createHomeMetadata"]
					},
					{
						"module": "{{serverImport}}",
						"names": ["client"]
					}
				],
				"exports": [
					{
						"name": "generateMetadata",
						"value": "createHomeMetadata(client)"
					}
				]
			}
		]
	},
	"env": {
		"baseUrl": "NEXT_PUBLIC_KIZLO_API_URL",
		"remote": {
			"siteSecret": "KIZLO_WP_SECRET",
			"wpUrl": "KIZLO_WP_URL",
			"wpUsername": "KIZLO_WP_USERNAME",
			"wpPassword": "KIZLO_WP_APP_PASSWORD"
		},
		"local": {
			"connect": "KIZLO_CONNECT",
			"siteSecret": "KIZLO_LOCAL_WP_SECRET",
			"wpUrl": "KIZLO_LOCAL_WP_URL",
			"wpUsername": "KIZLO_LOCAL_WP_USERNAME",
			"wpPassword": "KIZLO_LOCAL_WP_APP_PASSWORD"
		}
	},
	"dependencies": {
		"kizlo": "^0.15.1"
	}
}
