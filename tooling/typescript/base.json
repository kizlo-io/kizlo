{
	"$schema": "https://json.schemastore.org/tsconfig",
	"extends": "./build.json",
	"compilerOptions": {
		"paths": {
			"kizlo": ["${configDir}/../kizlo/src/index.ts"],
			"kizlo/config": ["${configDir}/../kizlo/src/config.ts"],
			"kizlo/test": ["${configDir}/../kizlo/src/test/index.ts"],
			// Not a published entry and cannot become one: it constructs the generated client, whose
			// `declare module "kizlo"` would register this repo's WordPress client as every consuming
			// app's. Reachable from tests in this repo only. See packages/kizlo/src/test/harness.ts.
			"kizlo/test-harness": ["${configDir}/../kizlo/src/test/harness.ts"],
			"kizlo/nextjs": ["${configDir}/../kizlo/src/integrations/nextjs/index.ts"],
			"kizlo/nextjs/server": ["${configDir}/../kizlo/src/integrations/nextjs/server.ts"],
			"@kizlo/cf7": ["${configDir}/../cf7/src/index.ts"],
			"@kizlo/cf7/test": ["${configDir}/../cf7/src/test/index.ts"],
			"@kizlo/shared": ["${configDir}/../shared/src/index.ts"],
			"@kizlo/woocommerce": ["${configDir}/../woocommerce/src/index.ts"],
			"@kizlo/woocommerce/test": ["${configDir}/../woocommerce/src/test/index.ts"],
		}
	}
}
