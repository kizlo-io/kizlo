	{
		"name": "if then else draft07",
		"required": {
			"if": {
				"properties": {
					"cart": {
						"properties": {
							"needs_shipping": {
								"const": true
							}
						}
					}
				}
			},
			"then": {
				"properties": {
					"cart": {
						"properties": {
							"items": {
								"minItems": 2
							}
						}
					}
				}
			},
			"else": false
