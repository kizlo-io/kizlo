		"required": {
			"customer": {
				"properties": {
					"address": {
						"properties": {
							"kizlo/tax-id": {
								"pattern": "^GB"
							}
						}
					}
				}
			}
		},
		"hidden": false,
		"document": {
			"customer": {
				"address": {
					"email": "",
