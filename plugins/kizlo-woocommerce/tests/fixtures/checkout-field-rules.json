	{
		"name": "contains enum and minimum cart total",
		"required": {
			"allOf": [
				{
					"properties": {
						"cart": {
							"properties": {
								"items": {
									"contains": {
										"enum": [42]
									}
								}
							}
						}
					}
				},
				{
					"properties": {
						"cart": {
							"properties": {
								"totals": {
									"properties": {
										"total_price": {
											"minimum": 10000
										}
									}
								}
							}
						}
					}
				}
			]
		},
		"hidden": false,
		"document": {
			"cart": {
				"items": [42, 42, 7],
				"needs_shipping": true,
				"totals": {
					"total_price": 12000
				}
			}
		},
		"expected": {
			"required": true,
			"hidden": false
		}
	},
	{
		"name": "anyOf and not reject cart",
