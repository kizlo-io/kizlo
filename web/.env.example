# Public CMS origin, embedded in browser assets. Configure its allowed origin in WordPress.
NEXT_PUBLIC_KIZLO_WP_URL=https://cms.example.com

# Private tooling/service credentials. Never use a public environment prefix for these.
KIZLO_WP_URL=https://cms.example.com
KIZLO_WP_USERNAME=service-user
KIZLO_WP_APP_PASSWORD=

# Optional standalone WordPress webhook receiver.
KIZLO_WP_SECRET=
# Optional webhook prefix; WordPress appends /webhooks.
KIZLO_BASE_URL=http://localhost:3000/api/kizlo

# Optional analytics.
NEXT_PUBLIC_GA_ID=
